rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // المجموعات العامة القابلة للقراءة للجميع (الموقع العام)
    function isPublicRead() {
      return request.auth != null || true;
    }

    // الملف العام للموقع
    match /settings/{doc=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid != null;
    }

    // التطبيقات والشروحات والمدونة وروابط التواصل والأخبار
    match /apps/{doc=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /tutorials/{doc=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /blog/{doc=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /social_links/{doc=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /tech_news/{doc=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /saudi_news/{doc=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /google_trends/{doc=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /twitter_trends/{doc=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /global_news/{doc=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // التعليقات: أي شخص يمكنه إضافة، والمسؤول فقط يقرأ/يوافق/يحذف
    match /feedback/{doc=**} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // الإحصائيات: للقراءة العامة والكتابة بدون مصادقة (عداد الزيارات)
    match /analytics/{doc=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
