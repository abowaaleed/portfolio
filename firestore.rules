rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // حساب المسؤول الوحيد المسموح له بالكتابة في المحتوى
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'abo.waaleed@gmail.com';
    }

    // القراءة العامة للموقع
    match /settings/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /apps/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tutorials/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blog/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /social_links/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tech_news/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /saudi_news/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /google_trends/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /twitter_trends/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /global_news/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // التعليقات: أي شخص يستطيع إرسال، admin فقط يقرأ/يوافق/يحذف
    match /feedback/{doc=**} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // عداد الزيارات: قراءة عامة + كتابة عامة (تتزايد تلقائياً)
    match /analytics/{doc=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
